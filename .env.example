# Weather API Key (Open-Meteo fallback included automatically if blank)
WEATHER_API_KEY=your_weather_api_key
NEXT_PUBLIC_WEATHER_API_KEY=your_weather_api_key

# Aviationstack Real Flight API Key (Catalog fallback included)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
NEXT_PUBLIC_AVIATIONSTACK_API_KEY=your_aviationstack_api_key

# SerpAPI Google Flights & Hotels API Key (Catalog fallback included)
SERPAPI_KEY=your_serpapi_key
NEXT_PUBLIC_SERPAPI_KEY=your_serpapi_key

# RapidAPI (TripAdvisor / Booking.com API Key)
RAPIDAPI_KEY=your_rapidapi_key
NEXT_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key

# Image Providers (Server-side ONLY - Never expose to client)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_PRIMARY_PROVIDER=pexels
PEXELS_HOURLY_CAP=150
UNSPLASH_HOURLY_CAP=40

# Performance & Pipeline Optimization (Phases 1-3)
PERF_LOG=
GENERATION_DEADLINE_MS=
LIVE_FLIGHTS_HOTELS=
LLM_MODEL=
PREWARM_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ==============================================================================
# XPLORA Environment Variables (.env.example)
#
# CRITICAL SECURITY RULE:
# All provider credentials MUST remain strictly server-only.
# NEVER use NEXT_PUBLIC_* for API keys or secrets.
# ==============================================================================

# Database
DATABASE_URL="file:./dev.db"

# Server-Only Travel & AI Provider Credentials
SERPAPI_KEY=your_serpapi_key_here
GEMINI_API_KEY=your_gemini_api_key_here
WEATHER_API_KEY=your_weatherapi_key_here
OPENTRIPMAP_API_KEY=your_opentripmap_key_here
PREWARM_SECRET=your_admin_prewarm_secret_here

# Server-Side Travel & AI Capability Flags (true / false)
LIVE_FLIGHTS_ENABLED=true
LIVE_STAYS_ENABLED=true
GEMINI_CHAT_ENABLED=true
LIVE_TRAINS_ENABLED=true
LIVE_BUSES_ENABLED=false

# Railway Provider (Qrail - Server-side ONLY)
QRAIL_API_KEY=your_qrail_api_key_here
QRAIL_BASE_URL=https://api.qrail.in

# Image Providers (Server-side ONLY)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_PRIMARY_PROVIDER=pexels
PEXELS_HOURLY_CAP=150
UNSPLASH_HOURLY_CAP=40

# Optional Performance & Cache Settings
PERF_LOG=false
GENERATION_DEADLINE_MS=12000
LLM_MODEL=gemini-1.5-flash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

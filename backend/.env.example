# Weather API Key (Open-Meteo fallback included automatically if blank)
WEATHER_API_KEY=

# Aviationstack Real Flight API Key (Catalog fallback included)
AVIATIONSTACK_API_KEY=

# SerpAPI Google Flights & Hotels API Key (Catalog fallback included)
SERPAPI_KEY=

# RapidAPI TripAdvisor API Key
RAPIDAPI_KEY=

# Allowed CORS Origins (comma-separated, default: http://localhost:3000,http://127.0.0.1:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
